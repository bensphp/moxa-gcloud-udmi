# systemd unit for moxa-gcloud-udmi on a Moxa gateway (e.g. UC-8220, Debian 11).
#
# It assumes the user `moxa` and a checkout in /home/moxa/moxa-gcloud-udmi: adapt User=,
# WorkingDirectory= and ExecStart= if your installation differs.
#
# Install:
#   sudo cp deploy/moxa-gcloud-udmi.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now moxa-gcloud-udmi
#
# Restart=always is required: a UDMI `system.operation.mode = restart` request makes the gateway
# exit with status 192 and systemd starts it again. Fatal configuration errors exit with status 1
# and are retried every RestartSec forever (an unattended gateway recovers once the configuration
# is fixed). StateDirectory= provides /var/lib/moxa-gcloud-udmi for the persisted restart counter.

[Unit]
Description=Moxa MXcloudgate to UDMI gateway (moxa-gcloud-udmi)
After=network-online.target mosquitto.service
Wants=network-online.target
# Never stop retrying (the default start limit would give up after a few quick failures).
StartLimitIntervalSec=0

[Service]
Type=simple
User=moxa
WorkingDirectory=/home/moxa/moxa-gcloud-udmi
ExecStart=/usr/bin/python3 /home/moxa/moxa-gcloud-udmi/src/main.py -c /home/moxa/moxa-gcloud-udmi/resources/config-google-gateway.json
StateDirectory=moxa-gcloud-udmi
Restart=always
RestartSec=10
# A UDMI restart (exit 192) is intended: restart without marking the unit failed.
SuccessExitStatus=192
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
